---
import type { Project } from '../data/site';
const { project, index = 0 } = Astro.props as { project: Project; index?: number };
const lang = Astro.props.lang ?? 'zh';
const isEnglish = lang === 'en';
const prefix = isEnglish ? '/EN' : '';
---
<article class="project-card reveal" style={`--delay: ${index * 70}ms`}><div class="project-card-top"><span class="project-number">0{index + 1}</span><time>{project.date}</time></div><p class="project-eyebrow">{project.eyebrow}</p><h3><a href={`${prefix}/projects/${project.slug}/`}>{project.title}<span aria-hidden="true"> ↗</span></a></h3><p class="project-summary">{project.summary}</p><div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div><a class="text-link" href={`${prefix}/projects/${project.slug}/`}>{isEnglish ? 'View project details' : '查看项目详情'} <span aria-hidden="true">→</span></a></article>
