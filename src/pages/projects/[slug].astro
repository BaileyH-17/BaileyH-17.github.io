---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Bailey Huang`} description={project.summary}><div class="container detail-page"><a class="back-link" href="/#projects">← 返回项目列表</a><header class="detail-header"><p class="kicker">{project.eyebrow}</p><h1>{project.title}</h1><div class="detail-meta"><time>{project.date}</time><div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div></div></header><div class="detail-layout"><article class="detail-content"><p class="detail-lede">{project.summary}</p><h2>主要工作</h2><ul>{project.bullets.map((bullet) => <li>{bullet}</li>)}</ul></article><aside class="detail-aside"><p class="section-label">项目</p><p><code>/projects/{project.slug}/</code></p><p>内容来自 <code>src/data/site.ts</code>。</p></aside></div></div></BaseLayout>
