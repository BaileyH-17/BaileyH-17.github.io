---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { profile, projects, skills } from '../../data/site.en';
---
<BaseLayout lang="en" title={`${profile.name} — Edge AI`}><div class="container home">
<section class="hero" id="about"><div class="hero-main reveal"><div class="paper-label paper-label-top">FIELD NOTES / 001</div><p class="kicker">{profile.role}</p><h1>Bailey Huang<br /><em>黄宝莹</em></h1><p class="hero-lede">Automation undergraduate at Xi’an Jiaotong University, working on edge AI deployment, inference optimization, and multimodal vision.</p><div class="hero-actions"><a class="button button-primary" href="#projects">View projects <span>↓</span></a><a class="button" href={`mailto:${profile.email}`}>Contact <span>↗</span></a></div><div class="hero-tags"><span>Model deployment</span><span>Computer vision</span><span>AI systems</span></div><div class="paper-label paper-label-bottom">XI'AN · SHENZHEN · 2026</div></div><div class="hero-aside reveal"><div class="profile-cutout"><img src="/media/images/profile_photo.webp" alt="Portrait of Bailey Huang" /></div></div></section>
<div class="content-grid"><aside class="profile-column" id="contact"><div class="profile-block reveal"><p class="section-label">Profile</p><p>{profile.description}</p><dl><dt>Education</dt><dd>Xi’an Jiaotong University · B.Eng. Automation</dd><dt>Period</dt><dd>2023.09 — 2027.06</dd><dt>Contact</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a><br /><a href={`tel:${profile.phone}`}>{profile.phone}</a></dd></dl></div><div class="profile-block reveal"><p class="section-label">Toolkit</p><div class="skill-cloud">{skills.map((skill) => <span>{skill}</span>)}</div></div><div class="profile-block reveal"><p class="section-label">Elsewhere</p><a class="github-link" href={profile.github} target="_blank" rel="noreferrer">GitHub / BaileyH-17 <span>↗</span></a></div></aside>
<div class="main-column"><section id="experience" class="experience-section reveal"><div class="section-heading"><div><p class="section-label">Experience</p><h2>Internship</h2></div><p>Edge deployment and AI platform engineering.</p></div><div class="experience-feature"><div class="feature-index">01</div><div><p class="project-eyebrow">ArexVision · Shenzhen</p><h3>Edge AI Deployment Engineering Intern</h3><p>Worked on training strategy, quantization, C/C++ pre- and post-processing, edge-board validation, and K3s platform setup.</p><a class="text-link" href="/EN/projects/edge-ai-deployment/">View experience <span>→</span></a></div><time>2026.06 — 2026.09</time></div></section>
<section id="projects" class="projects-section"><div class="section-heading reveal"><div><p class="section-label">Selected projects</p><h2>Projects</h2></div><p>Research work and technical practice.</p></div><div class="project-grid">{projects.slice(1).map((project, index) => <ProjectCard project={project} index={index + 1} lang="en" />)}</div></section></div></div></div></BaseLayout>
