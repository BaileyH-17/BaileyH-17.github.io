---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects, skills } from '../data/site';
---
<BaseLayout><div class="container home">
<section class="hero" id="about"><div class="hero-main reveal"><div class="paper-label paper-label-top">FIELD NOTES / 001</div><p class="kicker">{profile.role}</p><h1>Bailey Huang<br /><em>黄宝莹</em></h1><p class="hero-lede">西安交通大学自动化专业本科生。研究与实践方向：端侧 AI 部署、模型推理优化、多模态视觉。</p><div class="hero-actions"><a class="button button-primary" href="#projects">查看项目 <span>↓</span></a><a class="button" href={`mailto:${profile.email}`}>联系我 <span>↗</span></a></div><div class="hero-tags"><span>Model deployment</span><span>Computer vision</span><span>AI systems</span></div><div class="paper-label paper-label-bottom">XI'AN · SHENZHEN · 2026</div></div><div class="hero-aside reveal"><div class="profile-cutout"><img src="/profile_photo.webp" alt="黄宝莹的形象照" /></div><div class="hero-card"><div class="hero-card-top"><span>研究方向</span><span>2026</span></div><h2>端侧 AI<br /><strong>与智能系统</strong></h2><div class="hero-rule"></div><p class="mono-label">当前关注</p><ul><li>模型量化与端侧推理</li><li>多模态视频理解</li><li>AI 基础设施与调度</li></ul><div class="hero-location"><span>Xi'an</span><span>·</span><span>Shenzhen</span></div></div></div></section>
<div class="content-grid"><aside class="profile-column" id="contact"><div class="profile-block reveal"><p class="section-label">Profile</p><p>{profile.description}</p><dl><dt>Education</dt><dd>西安交通大学 · 自动化本科</dd><dt>Period</dt><dd>2023.09 — 2027.06</dd><dt>Contact</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a><br /><a href={`tel:${profile.phone}`}>{profile.phone}</a></dd></dl></div><div class="profile-block reveal"><p class="section-label">Toolkit</p><div class="skill-cloud">{skills.map((skill) => <span>{skill}</span>)}</div></div><div class="profile-block reveal"><p class="section-label">Elsewhere</p><a class="github-link" href={profile.github} target="_blank" rel="noreferrer">GitHub / BaileyH-17 <span>↗</span></a></div></aside>
<div class="main-column"><section id="experience" class="experience-section reveal"><div class="section-heading"><div><p class="section-label">Experience</p><h2>实习经历</h2></div><p>端侧模型部署与 AI 平台开发。</p></div><div class="experience-feature"><div class="feature-index">01</div><div><p class="project-eyebrow">ArexVision · Shenzhen</p><h3>端侧 AI 部署工程师实习生</h3><p>负责海洋生物检测模型的训练策略、量化编译、C/C++ 前后处理、边缘板验证和 K3s 平台搭建。</p><a class="text-link" href="/projects/edge-ai-deployment/">查看经历 <span>→</span></a></div><time>2026.06 — 2026.09</time></div></section>
<section id="projects" class="projects-section"><div class="section-heading reveal"><div><p class="section-label">Selected projects</p><h2>项目经历</h2></div><p>研究项目与技术实践。</p></div><div class="project-grid">{projects.slice(1).map((project, index) => <ProjectCard project={project} index={index + 1} />)}</div></section></div></div></div></BaseLayout>
