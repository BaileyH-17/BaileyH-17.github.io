---
import { profile } from '../data/site';
import '../styles/global.css';
const { title = `${profile.name} — ${profile.role}`, description = profile.description } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#0b1220" /><title>{title}</title></head><body>
<header class="site-header"><div class="container header-inner"><a class="wordmark" href="/" aria-label="返回首页"><span class="wordmark-mark">BH</span><span>{profile.name}</span></a><nav aria-label="主导航"><a href="/#about">关于</a><a href="/#experience">经历</a><a href="/#projects">项目</a><a href="/#contact">联系</a></nav><span class="availability"><i></i> 西安交通大学 · 自动化</span></div></header>
<main><slot /></main><footer class="site-footer container"><span>© 2026 {profile.name}</span><span>西安交通大学 · 自动化</span></footer></body></html>
