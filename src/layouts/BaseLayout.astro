---
import { profile } from '../data/site';
import '../styles/global.css';
const { title = `${profile.name} — ${profile.role}`, description = profile.description, lang = 'zh' } = Astro.props;
const isEnglish = lang === 'en';
---
<!doctype html><html lang={isEnglish ? 'en' : 'zh-CN'}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#0b1220" /><title>{title}</title></head><body>
<header class="site-header"><div class="container header-inner"><a class="wordmark" href={isEnglish ? '/EN' : '/'} aria-label={isEnglish ? 'Back to home' : '返回首页'}><span class="wordmark-mark">BH</span><span>{profile.name}</span></a><nav aria-label={isEnglish ? 'Primary navigation' : '主导航'}><a href={isEnglish ? '/EN#about' : '/#about'}>{isEnglish ? 'About' : '关于'}</a><a href={isEnglish ? '/EN#experience' : '/#experience'}>{isEnglish ? 'Experience' : '经历'}</a><a href={isEnglish ? '/EN#projects' : '/#projects'}>{isEnglish ? 'Projects' : '项目'}</a><a href={isEnglish ? '/EN#contact' : '/#contact'}>{isEnglish ? 'Contact' : '联系'}</a></nav><div class="header-side"><a class="language-switch" href={isEnglish ? '/' : '/EN'} aria-label={isEnglish ? '切换中文' : 'Switch to English'}>{isEnglish ? '中' : '中'} <span>|</span> {isEnglish ? 'EN' : 'EN'}</a><span class="availability"><i></i> {isEnglish ? 'Xi’an Jiaotong University · Automation' : '西安交通大学 · 自动化'}</span></div></div></header>
<main><slot /></main><footer class="site-footer container"><span>© 2026 {profile.name}</span><span>{isEnglish ? 'Xi’an Jiaotong University · Automation' : '西安交通大学 · 自动化'}</span></footer></body></html>
